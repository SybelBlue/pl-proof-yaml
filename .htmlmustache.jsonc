      "schema": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "type": "object",
        "required": ["answers-name"],
        "properties": {
          "answers-name": {},
          "detailed-help-text": {
            "enum": ["true", "false"]
          },
          "display": {
            "enum": ["block", "inline"]
          },
          "hide-answer-panel": {
            "enum": ["true", "false"]
          },
          "hide-help-text": {
            "enum": ["true", "false"]
          },
          "hide-letter-keys": {
            "enum": ["true", "false"]
          },
          "hide-score-badge": {
            "enum": ["true", "false"]
          },
          "max-correct": {},
          "max-select": {},
          "min-correct": {},
          "min-select": {},
          "number-answers": {},
          "order": {
            "enum": ["fixed", "random"]
          },
          "partial-credit": {
            "enum": ["coverage", "each-answer", "false", "net-correct", "off", "true"]
          },
          "partial-credit-method": {
            "enum": ["COV", "EDC", "PC"]
          },
          "show-number-correct": {
            "enum": ["true", "false"]
