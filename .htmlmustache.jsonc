            "enum": ["true", "false"]
          },
          "answers-name": {},
          "aria-label": {},
          "atol": {},
          "comparison": {
            "enum": ["decdig", "relabs", "sigfig"]
          },
          "digits": {},
          "initial-value": {},
          "label": {},
          "rtol": {},
          "show-help-text": {
            "enum": ["true", "false"]
          },
          "weight": {}
        }
      }
    },
    {
