              "name": "pl-text"
            },
            {
              "name": "pl-triangle"
            },
            {
              "name": "pl-vector"
            }
          ],
          "allowAdditionalChildren": true,
          "schema": {
            "$schema": "http://json-schema.org/draft-06/schema#",
            "properties": {
              "draw-error-box": {}
            }
          }
        },
        {
          "name": "pl-controls",
          "children": [
            {
              "name": "pl-drawing-button"
            },
            {
              "name": "pl-controls-group",
              "children": [
                {
                  "name": "pl-drawing-button"
                }
              ],
              "schema": {
                "$schema": "http://json-schema.org/draft-06/schema#",
                "properties": {
                  "label": {}
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "pl-sketch",
      "schema": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "type": "object",
        "required": ["answers-name"],
        "properties": {
          "allow-blank": {
            "enum": ["true", "false"]
          },
          "answers-name": {},
          "enforce-bounds": {
            "enum": ["true", "false"]
          },
          "height": {},
          "overlay-solution": {
            "enum": ["true", "false"]
          },
          "read-only": {
            "enum": ["true", "false"]
          },
          "weight": {},
          "width": {},
          "x-range": {},
          "y-range": {}
        }
      },
      "children": [
        {
          "name": "pl-sketch-grade"
        },
        {
          "name": "pl-sketch-initial"
        },
        {
          "name": "pl-sketch-solution"
        },
        {
          "name": "pl-sketch-tool"
        }
      ]
    },
    {
      "name": "clickable-image"
    },
    {
      "name": "course-element"
    },
    {
      "name": "extendable-element"
    },
    {
      "name": "math-field"
    },
    // Custom Elements
    {
      "name": "pl-proof-yaml"
    }
  ]
}
