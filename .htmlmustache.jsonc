              "distractor-for": {},
              "final": {},
              "indent": {},
              "initially-placed": {},
              "ordering-feedback": {},
              "ranking": {},
              "score": {},
              "tag": {},
              "correct": {
                "enum": ["false", "true"]
              },
              "feedback": {}
            }
          }
        }
      ]
    },
    {
      "name": "pl-multiple-choice",
      "schema": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "type": "object",
        "required": ["answers-name"],
        "properties": {
