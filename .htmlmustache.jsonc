              "initially-placed": {
                "enum": ["true", "false"]
              },
              "ranking": {},
              "tag": {}
            }
          }
        },
        {
          "name": "pl-block-group",
          "schema": {
            "$schema": "http://json-schema.org/draft-06/schema#",
            "type": "object",
            "properties": {
              "depends": {},
              "tag": {}
            }
          },
          "children": [
            {
              "name": "pl-answer",
              "schema": {
                "$schema": "http://json-schema.org/draft-06/schema#",
                "type": "object",
                "properties": {
                  "correct": {
                    "enum": ["false", "true"]
                  },
                  "depends": {},
                  "distractor-feedback": {},
                  "distractor-for": {},
                  "final": {
                    "enum": ["false", "true"]
                  },
                  "indent": {},
                  "ordering-feedback": {},
                  "initially-placed": {
                    "enum": ["true", "false"]
                  },
                  "ranking": {},
                  "tag": {}
                }
              }
            }
          ]
        }
      ]
    },
    {
