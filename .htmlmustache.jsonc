        }
      },
      "children": [
        {
          "name": "pl-answer",
          "schema": {
            "$schema": "http://json-schema.org/draft-06/schema#",
            "type": "object",
            "properties": {
              "correct": {
                "enum": ["false", "true"]
              },
              "depends": {},
              "distractor-feedback": {},
              "distractor-for": {},
              "final": {
                "enum": ["false", "true"]
              },
              "indent": {},
